<Project Sdk="MSBuild.Sdk.Extras/3.0.23">
	<PropertyGroup>
		<TargetFrameworks>uap10.0.18362;netstandard2.0;net6.0-windows10.0.18362</TargetFrameworks>
		<!-- Ensures the .xr.xml files are generated in a proper layout folder -->
		<GenerateLibraryLayout>true</GenerateLibraryLayout>
		<IncludeContentInPack>false</IncludeContentInPack>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>Uno Platform</Authors>
		<PackageProjectUrl>https://github.com/unoplatform/uno.fonts</PackageProjectUrl>
		<RepositoryUrl>https://github.com/unoplatform/uno.fonts</RepositoryUrl>
		<Copyright>Copyright (C) 2015-$([System.DateTime]::Now.ToString(`yyyy`)) Uno Platform inc. - all rights reserved</Copyright>
		<PackageId>Uno.Fonts.Roboto</PackageId>
		<DefaultLanguage>en-US</DefaultLanguage>
		<LangVersion>10.0</LangVersion>
		<PackageLicenseExpression>Apache-2.0 AND OFL-1.1</PackageLicenseExpression>
		<Nullable>enable</Nullable>
		<WarningsAsErrors>enable</WarningsAsErrors>
		<Title>Uno Platform Roboto Font</Title>
		<Product>$(AssemblyName) ($(TargetFramework))</Product>
		<Description>Uno Platform Roboto Font. Bundles the Roboto variable font (Roboto.ttf) with static instances for every weight from Thin to Black and a font manifest that resolves FontWeight 100-900 to those instances on Skia and iOS targets, for use with Uno Platform applications.</Description>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../../icon.png" Pack="true" PackagePath="icon.png" />
		<None Include="Fonts/OFL.txt" Pack="true" PackagePath="OFL.txt" />
		<None Include="buildTransitive/netstandard2.0/Uno.Fonts.Roboto.targets" Pack="true" PackagePath="buildTransitive/netstandard2.0/" />
	</ItemGroup>

	<Target Name="UnoForceIncludeIcon" BeforeTargets="_GetPackageFiles">
		<ItemGroup>
			<!-- Quite ugly based on an undocumented implementation detail on NuGet side -->
			<_PackageFiles Include="@(None)" Condition=" %(None.Pack) == 'true' ">
				<BuildAction Condition="'%(None.BuildAction)' == ''">None</BuildAction>
			</_PackageFiles>
		</ItemGroup>
	</Target>

	<!--
	Font sources (OFL-1.1; per-file hashes in Fonts/SHA256SUMS, check with `sha256sum -c SHA256SUMS`):
	  Roboto.ttf   = google/fonts@6183fc0 ofl/roboto/Roboto[wdth,wght].ttf (Version 3.015; 2026),
	                 identical to googlefonts/roboto-classic v3.015 web/split/Roboto[wdth,wght].ttf
	  Roboto-*.ttf = Google Fonts family download (https://fonts.google.com/download/list?family=Roboto),
	                 static/Roboto-*.ttf, Roboto v51 (Version 3.015; 2026), hinted web build
	-->
	<ItemGroup>
		<Content Include="Fonts/*.ttf" />
		<Content Include="Fonts/*.ttf.manifest" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('windows10'))">
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Fonts\*.ttf;Fonts\*.ttf.manifest" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CustomContentTarget</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="CustomContentTarget" Condition="'$(TargetFramework)'=='netstandard2.0'">
		<ItemGroup>
			<TfmSpecificPackageFile Include="Fonts/*.ttf">
				<PackagePath>lib/$(TargetFramework)/Uno.Fonts.Roboto/Fonts</PackagePath>
			</TfmSpecificPackageFile>

			<TfmSpecificPackageFile Include="Fonts/*.ttf.manifest">
				<PackagePath>lib/$(TargetFramework)/Uno.Fonts.Roboto/Fonts</PackagePath>
			</TfmSpecificPackageFile>

			<TfmSpecificPackageFile Include="../Uno.Fonts.Roboto.uprimarker">
				<PackagePath>lib/$(TargetFramework)</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>
</Project>
