<Project>
    <Target Name="UnoRemoveUnusedRoboto" AfterTargets="_UnoAddLibraryAssets">
        <ItemGroup>
            <!-- Heads that resolve weights through Roboto.ttf.manifest (Skia) never read the variable font, so drop it. -->
            <!-- Static instances are always kept: consumers reference them directly (e.g. Roboto-Regular.ttf). -->
            <!-- The asset items hold full, normalized paths, so the path must be normalized to match. -->
            <_AllChildProjectItemsWithTargetPath
                Remove="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'lib', 'netstandard2.0', 'Uno.Fonts.Roboto', 'Fonts', 'Roboto.ttf'))"
                Condition="'$(SupportsFontManifest)'=='true'" />
        </ItemGroup>
    </Target>
</Project>
